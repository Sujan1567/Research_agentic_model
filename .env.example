# Copy this file to .env and fill in your own values.
#     cp .env.example .env          (Windows: copy .env.example .env)
# NEVER commit .env to git. That is what .gitignore is for.

# Required. The script refuses to start without it.
# platform.openai.com > API keys > Create new secret key
OPENAI_API_KEY=sk-put-your-key-here

# Required for the search_web tool. Free key at tavily.com
# Without it the agent still runs, but every search says it is unavailable.
TAVILY_API_KEY=tvly-put-your-key-here

# Optional. Only needed for the send_to_discord tool (example 6).
# Discord: Channel Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL= Your_discord_url
